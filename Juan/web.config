<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>

        <!-- 1) HTTP → HTTPS -->
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2) Redirección de host específico a dominio principal -->
        <!-- Si alguien entra por au22002.www3.codesquad.tpi → redirige a au22001.codesquad.tpi -->
        <rule name="Redirect host au22002 to lb22002" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^lb22002\.www3\.codesquad\.tpi$" />
          </conditions>
          <action type="Redirect" url="https://lb22002.codesquad.tpi/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 3) /parcial/{carnet} → /{carnet} (redirige cambiando la barra del navegador) -->
        <rule name="Redirect parcial to root" stopProcessing="true">
          <match url="^parcial/([A-Za-z0-9]+)/?$" />
          <action type="Redirect"
                  url="https://{HTTP_HOST}/{R:1}"
                  appendQueryString="true"
                  redirectType="Permanent" />
        </rule>

        <!-- (Alternativa) Reescritura interna sin cambiar la URL visible
        <rule name="Rewrite parcial to root (internal)" stopProcessing="true">
          <match url="^parcial/([A-Za-z0-9]+)/?$" />
          <action type="Rewrite" url="/{R:1}/" appendQueryString="true" />
        </rule>
        -->

        <!-- 4) Proxy /api/* → json-server en localhost:3000 -->
        <rule name="API Proxy" stopProcessing="true">
          <match url="^code/(.*)" />
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>

      </rules>
    </rewrite>

    <!-- Habilita proxy inverso (requiere ARR instalado) -->
    <proxy reverseRewriteHostInResponseHeaders="true" />

    <!-- Redirección HTTP global desactivada (usamos URL Rewrite) -->
    <httpRedirect enabled="false" destination="" httpResponseStatus="Permanent" />

    <!-- Errores -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="404.html" responseMode="File" />
    </httpErrors>
  </system.webServer>
</configuration>
